; ***************************************************************************************
;
; Check for a letter (A-Z or a-z)
;
; On Entry:
;       A = character to check
; On Exit:
;       Preserves A
;       Carry clear if character is an upper or lower case letter (A-Z or a-z)
;       otherwise carry set
;
; ***************************************************************************************
readLetterFromString:
                pha
                and #$DF
                cmp #'A'        ; taken if not letter
                bcc noLetter
                cmp #'Z'+1
                bcc yesLetter       ; taken if letter
noLetter:
                sec
yesLetter:
                pla
                rts