bufferTableEntry: .macro address,size,table
.if \table==0
                .byte >((\address)-(256-(\size)))
                .elsif \table==1
                .byte <((\address)-(256-(\size)))
                .elsif \table==2
                .byte 256-(\size)
.endif
                .endmacro

bufferTable: .macro table
                .bufferTableEntry keyboardInputBuffer,bufferKeyboardSize,\table
                .bufferTableEntry tapeOrRS423InputBuffer,bufferRS423InputSize,\table
                .bufferTableEntry tapeOrRS423OutputBuffer, bufferRS423OutputSize,\table
                .bufferTableEntry printerBuffer, bufferPrinterSize,\table
                .bufferTableEntry soundChannel0Buffer, bufferSoundChannel0Size,\table
                .bufferTableEntry soundChannel1Buffer, bufferSoundChannel1Size,\table
                .bufferTableEntry soundChannel2Buffer, bufferSoundChannel2Size,\table
                .bufferTableEntry soundChannel3Buffer, bufferSoundChannel3Size,\table
                .bufferTableEntry speechBuffer, bufferSpeechSize,\table
                .endmacro
                
LE1A3: .bufferTable 0
LE1AC: .bufferTable 1
