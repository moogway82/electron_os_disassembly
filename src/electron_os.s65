                .byte $22                    ; %0010 0010 - *OPT 2,1 - retry errors
                .byte $11                    ; %0001 0001 - *OPT 2,2 - abort errors
                .byte $00                    ; %0000 0000 - *OPT 1,0 - no messages
                .byte $88                    ; %1000 1000 - *OPT 1,1 - short messages
