                bcc LC863                    ; C85C= 90 05       ..
                eor $0248                    ; C85E= 4D 48 02    MH.
                sta $FB                      ; C861= 85 FB       .{
LC863:
                tya                          ; C863= 98          .
                ldx vduNumberOfLogicalColoursMinusOne                    ; C864= AE 60 03    .`.
                cpx #$03                     ; C867= E0 03       `.
                beq LC88A                    ; C869= F0 1F       p.
                bcc LC889                    ; C86B= 90 1C       ..
                lsr a                        ; C86D= 4A          J
                lsr a                        ; C86E= 4A          J
                php                          ; C86F= 08          .
                lsr a                        ; C870= 4A          J
                plp                          ; C871= 28          (
