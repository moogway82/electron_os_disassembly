                .word osbyte99 ; &99 - Insert character code into buffer [MasRef D.2-46]        
                .word osbyte9A ; &9A - Write video ULA control register [MasRef D.2-46]         
                .word rtsFFA2 ; &9B - Write to video ULA palette register and [MasRef D.2-47]  
                .word osbyteUnused ; &9C - Read/write serial ACIA control [MasRef D.2-47]           
                .word osbyte9D ; &9D - Write byte across Tube [MasRef D.2-48]                   
                .word osbyteUnused ; &9E - reserved for the speech system. [MasRef D.2-49]          
                .word osbyteUnused ; &9F - reserved for the speech system. [MasRef D.2-49]          
                .word osbyteA0 ; &A0 - Read VDU variable value [MasRef D.2-49]                  
                .word osbyteA6ToFF ; &A1 - Read CMOS RAM [MasRef D.2-49]                            
                .word callUSERV
                .word osword00               ; &00 - Read line from input stream to memory
                .word osword01               ; &01 - Read system clock
                .word osword02               ; &02 - Write system clock
                .word osword03               ; &03 - Read interval timer
                .word osword04               ; &04 - Write interval timer
                .word osword05               ; &05 - Read byte from I/O processor memory
                .word osword06               ; &06 - Write byte to I/O processor memory
                .word osword07               ; &07 - Generate a sound
                .word osword08               ; &08 - Define a sound envelope
                .word osword09               ; &09 - Read pixel logical colour
                .word osword0A               ; &0A - Read a character definition
                .word osword0B               ; &0B - Read the palette
                .word osword0C               ; &0C - Write the palette
                .word osword0D               ; &0D - Read current and previous graphics cursor positions
osbyte88:
                lda #$00
callUSERV:
                jmp (vectorUSERV)

; OSBYTE xx - Increment ROM polling semaphore
; -------------------------------------------
osbyte16:
                inc $0249                    ; E464= EE 49 02    nI.
LE467:
                rts                          ; E467= 60          `

; OSBYTE &7E - Acknowledge Escape state
; -------------------------------------
osbyte7E:
                ldx #$00                     ; X=0 for no pending Escape
                bit $FF                      ; If no pending, tell Tube and return
                bpl osbyte7C
                lda $0276                    ; Check Escape effects, skip if disabled
                bne LE47D
                cli                          ; Enable IRQs
                sta pagedModeCounter                    ; Clear paged line counter
                jsr LF5EA                    ; Close any open EXEC file
                jsr LDEEA                    ; Flush all buffers
LE47D:
                ldx #$FF                     ; X=&FF for Escape was pending

; OSBYTE &7C - Clear Escape state
; -------------------------------
osbyte7C:
                clc                          ; CLC to clear Escape state

; OSBYTE &7D - Set Escape state
; -----------------------------
osbyte7D:
                ror $FF                      ; Rotate into Escape flag
                bit $027A                    ; If no Tube, return
                bpl LE467
                jmp $0403                    ; Inform Tube and return

