; This is written with useable listing output in mind, which is why
; it's a bit weird.

vduEntry: .macro routine,n,lsb
.if \lsb

                .byte <\routine

                .elif !\lsb && \n==0
                
                .cerror ((\routine)&$8000)==0

                .byte >\routine

                .elif !\lsb

                .cerror !((>(\routine))>=vduRoutinesBasePage&&(>(\routine))<vduRoutinesBasePage+8)
                .cerror !((\n)>0&&(\n)<16)
                .byte (16-(\n))|(((>(\routine))-vduRoutinesBasePage)&$f)<<4
.endif
                .endmacro

vduRoutinesTable: .macro lsb
                .vduEntry vdu0EntryPoint,0,\lsb ; VDU 0
                .vduEntry vdu1EntryPoint,1,\lsb ; VDU 1
