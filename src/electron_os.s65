;
; Converts &2C-&3B to Function code
LF037:
                .byte $AC ; F037= AC          ,   \ Func+, ->
                .byte $AD ; F038= AD          -   \ Func+- ->
                .byte $AE ; F039= AE          /   \ Func+/ ->
                .byte $AF ; F03A= AF          .   \ Func+. ->
                .byte $80 ; F03B= 80 81       ..  \ Func+0 -> f0
                .byte $81
                .byte $82                    ; F03D= 82          .
                .byte $83                    ; F03E= 83          .
                .byte $84
                .byte $85
                .byte $86
                .byte $87
                .byte $88
                .byte $89          ; F044= 89 AA       .*  \ Func+: ->
                .byte $AA
                .byte $AB          ; F046= AB          +   \ Func+; ->

LF047:
                ldx #$FF                     ; F047= A2 FF       ".
LF049:
                inx                          ; F049= E8          h
                lsr a                        ; F04A= 4A          J
                bcc LF049                    ; F04B= 90 FC       .|
                stx $FC                      ; F04D= 86 FC       .|
                lda $FA                      ; F04F= A5 FA       %z
                eor #$FF                     ; F051= 49 FF       I.
                beq LF062                    ; F053= F0 0D       p.
                ldx #$00                     ; F055= A2 00       ".
LF057:
                inx                          ; F057= E8          h
                lsr a                        ; F058= 4A          J
                bcc LF057                    ; F059= 90 FC       .|
                txa                          ; F05B= 8A          .
                asl a                        ; F05C= 0A          .
                asl a                        ; F05D= 0A          .
                ora $FC                      ; F05E= 05 FC       .|
                tax                          ; F060= AA          *
                rts                          ; F061= 60          `

LF062:
                lda $FB                      ; F062= A5 FB       %{
                and #$3F                     ; F064= 29 3F       )?
                eor #$3F                     ; F066= 49 3F       I?
                ldx #$08                     ; F068= A2 08       ".
                bne LF057                    ; F06A= D0 EB       Pk

