;
; Default vector table
;
; Default handlers for vectors, used at RESET time.
;
; ***************************************************************************************
defaultPage02:
defaultVectorTable:
                .word LE07E                  ; vectorUSERV=$200
                .word LDB33                  ; vectorBRKV=$202 
                .word irq1EntryPoint         ; vectorIRQ1V=$204
                .word LDB89                  ; vectorIRQ2V=$206
                .word LDD14                  ; vectorCLIV=$208 
                .word LE544                  ; vectorBYTEV=$20a
                .word LE5BC                  ; vectorWORDV=$20c
                .word LDE2D                  ; vectorWRCHV=$20e
                .word LDC50                  ; vectorRDCHV=$210
                .word LF1D6                  ; vectorFILEV=$212
                .word LF0CC                  ; vectorARGSV=$214
                .word LF420                  ; vectorBGETV=$216
                .word LF480                  ; vectorBPUTV=$218
                .word rtsFFA2                ; vectorGBPBV=$21a
                .word LF320                  ; vectorFINDV=$21c
                .word LF0E8                  ; vectorFSCV=$21e 
                .word rtsFFA2                ; vectorEVNTV=$22
                .word rtsFFA2                ; vectorUPTV=$222 
