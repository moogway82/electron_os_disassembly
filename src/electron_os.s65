; CFS/RFS FSC
; ===========
LF0E8:
                cmp #$07                     ; F0E8= C9 07       I.
                bcs LF0D9                    ; F0EA= B0 ED       0m
                stx $BC                      ; F0EC= 86 BC       .<
                asl a                        ; F0EE= 0A          .
                tax                          ; F0EF= AA          *
