; ***************************************************************************************
; ***************************************************************************************
;
; Chapter 6: Changing MODEs
;
; ***************************************************************************************
; ***************************************************************************************

; ***************************************************************************************
;
; Initialise VDU variables and change MODE
;
; This is called at reset time
;
; On Entry:
;       A = screen MODE number
;
; ***************************************************************************************
initialiseVDUVariablesAndSetMODE:
                pha                                             ; save A (screen mode number)               ; CB12= 48          H
                ; Clear all VDU variables (0-126)
                ldx #(vduVariablesEnd - vduVariablesStart)      ; loop counter                              ; CB13= A2 7F       ".
                lda #$00                                        ; A=0                                       ; CB15= A9 00       ).
                sta vduStatusByte                               ; VDU status byte to set default conditions (zero)  ; CB17= 85 D0       .P
LCB19:
                sta vduVariablesStart-1,x                       ; zero VDU variables (0-126)                ; CB19= 9D FF 02    ...
                dex                                             ; with this loop                            ; CB1C= CA          J
                bne LCB19    
                ; Clear Channel 3 Sound and number of amplitude phases processed vars                       ; CB1D= D0 FA       Pz
                ldx #$04                                                                                    ; CB1F= A2 04       ".
LCB21:
                sta channel3Volume,x                                                                                 ; CB21= 9D 0B 08    ...
                dex                                                                                         ; CB24= CA          J
                bne LCB21    
                                                                                               ; CB25= D0 FA       Pz
                ; implode character definitions
                jsr osbyte14                                                                                 ; CB27= 20 5E CC     ^L
                pla                                                                                         ; CB2A= 68          h
                ; Set teletext cursor (interesting...)
                ldx #$7F                                                                                    ; CB2B= A2 7F       ".
                stx vduTeletextCharacterForCursor               ; set mode 7 cursor character 7F             ; CB2D= 8E 66 03    .f.
                ; fall through...

; ***************************************************************************************
;
; Set MODE
;
; On Entry:
;       A = screen MODE number
;
; ***************************************************************************************
setMODE:
.if version==300
                jsr getNormalisedMODE
                php
                sei
                sta vduCurrentScreenMODE
                lda miscellaneousControlRegisterCopy
                and #$C7
                ora vduCurrentScreenMODE
                jsr LE495
                stx vduCurrentScreenMODE
.else ;version!=300
                jsr getNormalisedMODE                    	; Returns X as Mode no. 0-6, A as mode * 8 for Lookup table ; CB30= 20 DA DA     ZZ
                stx vduCurrentScreenMODE                    												; CB33= 8E 55 03    .U.
                php                          																; CB36= 08          .
                sei                          																; CB37= 78          x
                sta internalCassetteFilingSystemVar         												; CB38= 8D F4 02    .t.
                lda miscellaneousControlRegisterCopy                    													; CB3B= AD 82 02    -..
                and #~(7<<miscellaneousControlRegister.displayModeShift)&$ff
                ora internalCassetteFilingSystemVar         												; CB40= 0D F4 02    .t.
                sta miscellaneousControlRegisterCopy                    													; CB43= 8D 82 02    ...
                sta miscellaneousControlRegister            												; CB46= 8D 07 FE    ..~
.endif

                ; Set characteristic vdu variables for the new mode
                plp                          																; CB49= 28          (
                lda numberOfColoursMinusOneInMODETable,x    ; Look up the no. colours for mode, store in A  ; CB4A= BD CF C3    =OC
                sta vduNumberOfLogicalColoursMinusOne       ; Save that in VDU Var             				; CB4D= 8D 60 03    .`.
                lda bytesPerCharacter,x                  	; Look up no. bytes per character 				; CB50= BD BB C3    =;C
                sta vduBytesPerCharacter                    ; Save it in VDU Var 							; CB53= 8D 4F 03    .O.
                lda pixelsPerByteMinusOneInMODETable,x      ; Look up pixels per byte 			            ; CB56= BD F5 C3    =uC
                sta vduPixelsPerByteMinusOne                ; Save in VDU Var 							    ; CB59= 8D 61 03    .a.
                bne LCB60                    																; CB5C= D0 02       P.
                lda #$07                     																; CB5E= A9 07       ).
LCB60:
                asl a                        																; CB60= 0A          .
                tay                          																; CB61= A8          (
                lda sixteenColourMODEMaskTable-1,y          ; mask table        							; CB62= B9 C1 C3    9AC
                sta vduColourMaskRight                    	; store as colour mask right 					; CB65= 8D 63 03    .c.
LCB68:
                asl a                        				; shift A left 									; CB68= 0A          .
                bpl LCB68                    				; until the top bit becomes set 				; CB69= 10 FD       .}
                sta vduColourMaskLeft                    	; store as colour mask left 					; CB6B= 8D 62 03    .b.
                ldy screenDisplayMemoryIndexTable,x                  										; CB6E= BC FB C3    <{C
                sty vduCurrentScreenMODEGroup                    											; CB71= 8C 56 03    .V.

                lda screenMemorySizeInBytesHigh,y                  											; CB74= B9 07 C4    9.D
                sta vduScreenSizeHighByte                    												; CB77= 8D 54 03    .T.
                lda screenMemoryStartHigh,y                  												; CB7A= B9 0B C4    9.D
                sta vduStartScreenAddressHighByte                    										; CB7D= 8D 4E 03    .N.
                
                ; A=Y=the screen memory type
                tya                         																; CB80= 98          .
                lsr a                        																; CB81= 4A          J
                eor #$01                    																; CB82= 49 01       I.
                tax                          				; X=A Index into multiplication table												; CB84= AA          *
                                                            ; (0 = MODE 7
                                                            ;  1 = MODE 4,5,6
                                                            ;  2 = MODE 0,1,2,3)
.if version==100 && subVersion==7
                lda multiplicationTabletoUseLow,x            ; load the low byte of the multiplication table to use
                sta vduMultiplicationTableLow                ; store
                lda #>multiplyBy640Table                     ; high byte of multiplication tables
                sta vduMultiplicationTableHigh               ; store. Now (.vduMultiplicationTableLow) points to 640x multiplication table or 40x.                                                            
.endif
                lda bytesPerRowLow,x                  														; CB85= BD 0F C4    =.D

                sta vduBytesPerCharacterRowLow               ; store bytes per character row 		    	; CB88= 8D 52 03    .R.
                inx                          																; CB8B= E8          h
                stx vduBytesPerCharacterRowHigh              ; bytes per character row (high byte)      	; CB8C= 8E 53 03    .S.
                lda #%01000011                				 ; Clear: paged scrolling selected, software scrolling (text window),
                											 ; not used, graphics cursor enabled (VDU 5), VDU disabled  	; CB8F= A9 43       )C
                jsr clearVDUStatusByteFlags               	 												; CB91= 20 30 C5     0E
                jsr vdu20EntryPoint                    		 ; Set Default screen colours					; CB94= 20 F6 C7     vG
                jsr vdu26EntryPoint                    														; CB97= 20 02 CA     .J
                jsr LC976                    																; CB9A= 20 76 C9     vI
LCB9D:
                ldx #$00                     																; CB9D= A2 00       ".
                lda vduStartScreenAddressHighByte                    										; CB9F= AD 4E 03    -N.
                jsr LC9F0                    																; CBA2= 20 F0 C9     pI
                jsr LC561                    																; CBA5= 20 61 C5     aE
                jsr LCC03                    																; CBA8= 20 03 CC     .L
                lda #$00                     ; CBAB= A9 00       ).
                sta pagedModeCounter                    ; CBAD= 8D 69 02    .i.
                sta vduTextCursorXPosition                    ; CBB0= 8D 18 03    ...
                sta vduTextCursorYPosition                    ; CBB3= 8D 19 03    ...

.if version==300&&(subVersion==213||subVersion==524)

                sta $d8
                ldy $034e
                sty $d9
                tay
LCBC9_300_213:
                sta ($d8),y
                iny
                bne LCBC9_300_213
                inc $d9
                bpl LCBC9_300_213
                bmi LCBE4

                ; Presumably debug code?
