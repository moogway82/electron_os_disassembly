; ***************************************************************************************
;
; Set text cursor screen addresses from X,Y position
;
; Let X,Y be the text cursor position (in absolute character cells from top left corner)
;
;     MODE 0: address = screen_start + Y*640 + X* 8
;     MODE 1: address = screen_start + Y*640 + X*16
;     MODE 2: address = screen_start + Y*640 + X*32
;     MODE 3: address = screen_start + Y*640 + X* 8
;     MODE 4: address = screen_start + Y*320 + X* 8
;     MODE 5: address = screen_start + Y*320 + X*16
;     MODE 6: address = screen_start + Y*320 + X* 8
;     MODE 7: address = screen_start + Y* 40 + X
;
; Given the text cursor X,Y position, use the multiplication table and other characteristic
; values for the current MODE to calculate the address on screen.
;
; On Entry:
;       .vduTextCursorX/YPosition stores the X,Y coordinates of the text cursor
;
; On Exit:
;       Carry clear
;       Stores the result in .vduTextCursorCRTCAddressLow/High, then wraps the address back on
;       screen if beyond the bottom of the screen. Store the new wrapped result in
;       .vduWriteCursorScreenAddressLow/High.
;
; ***************************************************************************************
setTextCursorScreenAddresses:
                lda vduTextCursorYPosition          ; current text line                         ; CE42= AD 19 03    -..
                asl a                               ; multiply by two to get table offset       ; CE45= 0A          .
                tay                                 ; Y=A                                       ; CE46= A8          (

.if version==100 && subVersion==7
                lda (vduMultiplicationTableLow),y   ; get CRTC multiplication table pointer

                sta $D7                             ; .vduWriteCursorScreenAddressHigh=A
                iny                                 ; Y=Y+1
                lda #2                              ; A=2
                and vduCurrentScreenMODEGroup      ; AND with MODE group:
                                                    ;   0 = 20k (MODE 0,1,2)
                                                    ;   1 = 16k (MODE 3)
                                                    ;   2 = 10k (MODE 4,5)
                                                    ;   3 = 8k (MODE 6)
                                                    ;   4 = 1k (MODE 7)
                php                                 ; save flags
                lda (vduMultiplicationTableLow),y   ; get CRTC multiplication table pointer
                plp                                 ; pull flags
                beq LCE58
.else
                lda multiplyBy640Table,y
                sta $D7                             ; .vduWriteCursorScreenAddressHigh=A        ; CE4A= 85 D7       .W
                lda multiplyBy640Table+1,y                                                      ; CE4C= B9 6E C3    9nC
                ldy vduBytesPerCharacterRowHigh                                                 ; CE4F= AC 53 03    ,S.
                dey                          ; CE52= 88          .
                bne LCE58                    ; CE53= D0 03       P.
.endif
                lsr $D7                      ; CE55= 46 D7       FW
                ror a                        ; CE57= 6A          j
LCE58:
                adc vduScreenTopLeftAddressLow                    ; CE58= 6D 50 03    mP.
                sta $D6                      ; CE5B= 85 D6       .V
                lda $D7                      ; CE5D= A5 D7       %W
                adc vduScreenTopLeftAddressHigh                    ; CE5F= 6D 51 03    mQ.
                tay                          ; CE62= A8          (
                lda vduTextCursorXPosition                    ; CE63= AD 18 03    -..
                ldx vduBytesPerCharacter                    ; CE66= AE 4F 03    .O.
.if version==100 && subVersion==7
                dex                                 ; X=X-1
                beq mode7Cursor                     ; if (in MODE 7) then branch
                cpx #15                             ; is it mode 1 or mode 5? (four colour modes = 16 bytes per character)
.else
                cpx #$10                     ; CE69= E0 10       `.
.endif
                beq mode1or5Cursor                    ; CE6B= F0 03       p.
                bcc mode0346Cursor                    ; CE6D= 90 02       ..
                asl a                        ; CE6F= 0A          .
mode1or5Cursor:
                asl a                        ; CE70= 0A          .
mode0346Cursor:
                asl a                        ; CE71= 0A          .
                asl a                        ; CE72= 0A          .
                bcc skipIncs                    ; CE73= 90 02       ..
                iny                          ; CE75= C8          H
                iny                          ; CE76= C8          H
skipIncs:
                asl a                        ; CE77= 0A          .
                bcc skipInc                    ; CE78= 90 02       ..
                iny                          ; CE7A= C8          H
mode7Cursor:
                clc                          ; CE7B= 18          .
skipInc:
                adc $D6                      ; CE7C= 65 D6       eV
                sta $D6                      ; CE7E= 85 D6       .V
                tax                          ; CE80= AA          *
                tya                          ; CE81= 98          .
                adc #$00                     ; CE82= 69 00       i.
.if version==100 && subVersion==7
                sta vduTextCursorCRTCAddressHigh                   ; store the text cursor CRTC address (before any wraparound)

.endif
                bpl LCE8A                    ; CE84= 10 04       ..
                sec                          ; CE86= 38          8
                sbc vduScreenSizeHighByte                    ; CE87= ED 54 03    mT.
LCE8A:
                sta $D7                      ; CE8A= 85 D7       .W
                clc                          ; CE8C= 18          .
                rts                          ; CE8D= 60          `

