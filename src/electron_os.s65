; ********************** RESET High Water mark for Power on *****************************

; ***************************************************************************************
;
; Reset entry point
;
; Called on:
;       * Power on
;       * when a HARD BREAK occurs      (CTRL BREAK keys)
;       * when a SOFT BREAK occurs      (BREAK key)
;
; ***************************************************************************************
resetEntryPoint:
                lda #$40                     ; Put RTI in NMI code space
                sta nmiEntryPoint
                sei                          ; Disable IRQs, put in Decimal mode
                cld
                ldx #$FF                     ; Reset stack
                txs
                inx                          ; X=&00
                stx $FE00                    ;
                stx lastResetType                    ; Set Last Break Type to &00=SoftBreak
                lda #intClearAndPagingRegister.clearNMI|intClearAndPagingRegister.clearHighToneIRQ|intClearAndPagingRegister.clearRTCIRQ|intClearAndPagingRegister.clearDisplayEndIRQ|intClearAndPagingRegister.romPageEnable
                sta intClearAndPagingRegister
                lda intStatusAndControlRegister                    ; Read PowerOn flag from ULA
                and #intStatusAndControlRegister.powerOnReset
                eor #intStatusAndControlRegister.powerOnReset      ; Save PowerOn flag
                pha
                beq LD8FB                    ; If PowerOn, jump to clear memory

; Not PowerOn, check BreakAction flags
                lda escapeAndBreakEffect                    ; Get BreakAction from *FX200
                lsr a                        ; Divide by 2
                cmp #$01                     ; Not *FX200,2 or *FX200,3, skip past
                bne LD912

.if version==300
LD8FB:
                jsr LE768_300
.else
                lsr a                        ; Divide by 2 again to give A=0

; Clear memory if PowerOn or *FX200,2/3
LD8FB:
                ldx #$04                     ; Start at page 4
                stx $01
                sta $00                      ; (&00/1)=&0400
                tay                          ; Y=0
LD902:
                sta ($00),y                  ; Clear memory
                iny                          ; Loop for 256 bytes
                bne LD902
                iny                          ; Step from &00 to &01 to skip &0D00
                inc $01                      ; Loop until (&00/1)=&8000
                bpl LD902
.endif
                sta systemAvailableRAM       ; MaxMemSize=&00
                stx softKeyConsistencyFlag   ; Set soft keys as inconsistant

LD912:
                ldx #$3A                     ; Scan for key &3A - CTRL
                jsr LEC1E
                php                          ; D917= 08          .
                pla                          ; D918= 68          h
                asl a                        ; D919= 0A          .
                ldx #$9B                     ; D91A= A2 9B       ".
                ldy #defaultPage02End-defaultPage02
                pla                          ; D91E= 68          h
                beq LD92A                    ; D91F= F0 09       p.
                ldy #defaultPage02SoftResetEnd-defaultPage02
                bcc LD934                    ; D923= 90 0F       ..
                ldy #defaultPage02HardResetEnd-defaultPage02
                inc lastResetType                    ; D927= EE 8D 02    n..
LD92A:
                inc lastResetType                    ; D92A= EE 8D 02    n..
                lda #$FF                     ; D92D= A9 FF       ).
                sta startUpOptions                    ; D92F= 8D 8F 02    ...
                ldx #$90                     ; D932= A2 90       ".
LD934:
                lda #$00                     ; D934= A9 00       ).
LD936:
                cpx #$C3                     ; D936= E0 C3       `C
                bcc LD93C                    ; D938= 90 02       ..
                lda #$FF                     ; D93A= A9 FF       ).
LD93C:
                sta page2Start,x                  ; D93C= 9D 00 02    ...
                inx                          ; D93F= E8          h
                bne LD936                    ; D940= D0 F4       Pt
                stx $02F7                    ; D942= 8E F7 02    .w.
                txa                          ; D945= 8A          .
                ldx #$E2                     ; D946= A2 E2       "b
LD948:
                sta $00,x                    ; D948= 95 00       ..
                inx                          ; D94A= E8          h
                bne LD948                    ; D94B= D0 FB       P{

LD94D:
                lda defaultPage02-1,y                ; Set up vectors
                sta page2Start-1,y
                dey
                bne LD94D
                lda #$07                     ; D956= A9 07       ).
                sta $ED                      ; D958= 85 ED       .m
                sty $FC                      ; D95A= 84 FC       .|
                cli                          ; D95C= 58          X
                sei                          ; D95D= 78          x
                lda $FC                      ; D95E= A5 FC       %|
                beq LD965                    ; D960= F0 03       p.
                jsr LEEC2                    ; D962= 20 C2 EE     Bn
LD965:
                lda startUpOptions                    ; Get startup options
                jsr getNormalisedMODE                    ; Convert mode number into ULA mode setting
                ora #miscellaneousControlRegister.capsLockLED|miscellaneousControlRegister.tapeOutput
.if version==300
                jsr LE495
.else
                sta miscellaneousControlRegisterCopy                    ; D96D= 8D 82 02    ...
                sta miscellaneousControlRegister                    ; D970= 8D 07 FE    ..~
.endif
                sta cassetteDataShiftRegister                    ; D973= 8D 04 FE    ..~
                ldx #intStatusAndControlRegister.rtcIRQ|intStatusAndControlRegister.displayEndIRQ
                stx ulaInterruptMask                    ; D978= 8E 5B 02    .[.
                stx intStatusAndControlRegister                    ; D97B= 8E 00 FE    ..~
                jsr osbyte74                    ; D97E= 20 76 E9     vi
                ldx softKeyConsistencyFlag                    ; D981= AE 84 02    ...
                beq LD989                    ; D984= F0 03       p.
                jsr osbyte12                    ; D986= 20 C0 E7     @g
LD989:

; Check sideways ROMs and build ROM table
                ldx #$00                     ; Start at ROM 0
LD98B:
                jsr selectROMX                    ; Page in ROM X
                ldx #$03                     ; 3+1 bytes to check
                ldy romCopyrightOffsetPointer                    ; Get offset to (C) string
LD993:
                lda romStartAddress,y                  ; Get byte from ROM
                cmp LDC97,x                  ; Compare with '(C)'
.if version==300
                bne LD9E0
.else
                bne LD9CF                    ; No match, jump to skip this ROM
.endif
                iny                          ; Step to next byte to check
                dex                          ; Loop to check four bytes
                bpl LD993

; Check if this is a duplicate of a higher ROM
                ldx $F4                      ; get current ROM bank
.if version==300
.if subVersion==524
                nop
                nop
                nop
                nop
.else
                cpx #$a
                beq LD9E0
.endif
.else
                txa                          ; A=current ROM
                tay                          ; Y=current ROM
compareROMsLoop:
                iny                          ; next ROM up
                cpy #$10
                bcs romIsNotDuplicate   ; taken if no more higher ROMs
                tya                          ; A=current ROM

                ; form $7fff-ROM in ($fa), so that the Y register can
                ; be reused. (This does mean that $7fff is read, but
                ; that's fine, as it'll always be a match.)
                eor #$FF
                sta $FA
                lda #$7F
                sta $FB
compareROMContentsLoop:
                jsr prepareForROMPaging
                sty intClearAndPagingRegister                    ; page in higher ROM
                lda ($FA),y                  ; load higher ROM byte
                jsr prepareForROMPaging      
                stx intClearAndPagingRegister                    ; page in lower ROM
                cmp ($FA),y                  ; do bytes match?
                bne compareROMsLoop ; taken if ROMs don't match - check next ROM
                inc $FA                      ; next address LSB
                bne compareROMContentsLoop
                inc $FB                      ; next address MSB
                lda $FB
                cmp #$84                     ; compare up to $8400 or so
                bcc compareROMContentsLoop ; taken if below $8400 or so
LD9CF:
                ldx $F4
                bpl LD9E0
.endif

; This ROM is not a duplicate
romIsNotDuplicate:
                lda romTypeByte              ; Store ROM type in ROM table
                sta romInformationTable,x
                and #$8F                     ; Check if b7=0 and b3-b0=0
                bne LD9E0                    ; If not 6502 BASIC, skip past
                stx $024B                    ; Store as BASIC
LD9E0:
.if version==300
                ldx $f4
.endif
                inx                          ; Step to next ROM
                cpx #$10                     ; Loop until all 16 ROMs done
                bcc LD98B
.if version==300
                jsr LF0B5_300
.endif
                lda startUpOptions           ; Get startup options
                jsr initialiseScreenOnReset  ; Use it to select screen mode
                ldy #$CA                     ; Enter f10 into keyboard buffer
                jsr LE25F
                jsr LE87B                    ; Check Break Intercept Vector
                jsr LF08B                    ; Set up casette options
                lda #$81                     ; Write &81 to Tube control
                sta LFCE0
                lda LFCE0                    ; Read back from Tube control
                ror a                        ; Bit 0 didn't remain set, no Tube
                bcc LDA16
                lda #$01                     ; Write &01 to Tube control
                sta LFCE0
                lda LFCE0                    ; Read back from Tube control
                ror a                        ; Bit 0 didn't remain clear, no Tube
                bcs LDA16
                ldx #$FF                     ; Service call &FF - Tube PreInit
                jsr osbyte8F
                bne LDA16                    ; No response, no Tube support, skip past
                dec $027A                    ; Set TubePresent to &FF=Present

LDA16:
                ldy #$0E                     ; Initial value for OSHWM (PAGE)
                ldx #$01                     ; Service call &01 - claim shared workspace
                jsr osbyte8F
                ldx #$02                     ; Service call &02 - claim private workspace
                jsr osbyte8F
                sty $0243                    ; Set primary OSHWM
                sty $0244                    ; Set current OSHWM (PAGE)
                ldx #$FE                     ; Service call &FE - Tube PostInit
                ldy $027A                    ; Y=TubePresent flag
                jsr osbyte8F                    ; Send service call
                and $0267                    ; If claimed or banner supressed, skip past
                bpl LDA52

; Print startup banner
                ldy #$02                     ; Print 'Acorn Electron' message
                jsr LDC34
                lda lastResetType                    ; Soft Break, skip past
                beq LDA4D
                lda #$07                     ; Beep
                jsr OSWRCH

.if version==300
                ldy #<message64K-1
                lda $027f
                beq LDA31_300
                bmi LDA2A_300
                ldy #<messageTURBO-1
LDA2A_300:
                lda #>message64K
                jsr LDC36
                beq LDA4D
LDA31_300:
.endif
                
                jsr LD6DE                    ; Store software cursor
                jsr LCED5                    ; Copy Electron Acorn bitmap to cursor store
                jsr LD6DE                    ; Restore software cursor to draw the Acorn bitmap
LDA4D:
                ldy #$13                     ; Print Newlines
                jsr LDC34
LDA52:
                sec                          ; Call Break Intercept Vector
                jsr LE87B
                jsr osbyte76                    ; Get Shift key state
                php                          ; Copy flags into A
                pla
                lsr a                        ; Move Sift key state into bit 3
                lsr a
                lsr a
                lsr a
                eor startUpOptions                    ; Toggle with startup options
                and #$08
                tay                          ; Y=Boot option (Shift EOR Startup)
                ldx #$03                     ; Service call 3, boot filing system
                jsr osbyte8F
                beq LDA88                    ; Claimed, skip past checking ROMFS
                tya                          ; Shift not pressed, don't boot ROMFS
                bne LDA83
                lda #$8D                     ; Select ROMFS
                jsr osbyte8C8D
                ldx #<LF009                  ; Point to "/!BOOT"
                ldy #>LF009
                dec $0267                    ; Set 'errors return to Reset handler'
                jsr OSCLI                   ; Do */!BOOT
                inc $0267                    ; Clear 'error return to Reset handler'
                bne LDA88

; If ROMFS */!BOOT causes an error, it jumps back to here
LDA83:
                lda #$00                     ; Select TAPEFS
                jsr LE7A7

; look for default language
LDA88:
                lda lastResetType                    ; Not Soft Break, find default language
                bne LDA92
                ldx $028C                    ; Use current language if b7=0
                bpl LDAB0
LDA92:
                ldx #$0F                     ; Start at ROM 15 to find a default language
LDA94:
                lda romInformationTable,x    ; Get ROM type byte
                rol a                        ; If b6 set, use it
                bmi LDAB0
                dex                          ; Loop through all ROMs
                bpl LDA94
                lda #$00
                bit $027A                    ; If Tube present, enter Tube with A=&00
                bmi LDAD7
                brk                          ; No Tube, error 'No language'
                .byte $F9
                .text "Language?"
                brk

; ===========================================
; ENTER LANGUAGE ROM
; X=ROM number
; Cy=0 - entered at RESET
; Cy=1 - entered from OSBYTE 142
; ===========================================
LDAB0:
                clc                          ; CLC=Entering from RESET
osbyte8E:
                php                          ; Save Carry flag
                stx $028C                    ; Save as Current Language
                jsr selectROMX               ; Page in this ROM
                lda #>romName    ; Prepare to print from &8008
                ldy #<romName    ; 
                jsr LDC36                    ; Display ROM title at &8008
                sty $FD                      ; Store offset to end of
                                             ; title as last error
                                             ; message
                jsr OSNEWL                   ; Print two newlines
                jsr OSNEWL
                lda #$00
                sta firmKeyLength
                plp                          ; Get RESET/OSBYTE flag back
                lda #$01                     ; A=&01 for language entry
                bit $027A                    ; If Tube present, enter Tube code
                bmi LDAD7
                jmp romLanguageEntry ; Enter ROM language entry
LDAD7:
                jmp $0400                    ; Enter Tube code to start language

;-------------------------------------------------------------------------
; Convert MODE number into table offset
; On entry, A=mode
; On exit,  X=validated mode number 0-6
;           A=validated mode number * 8
getNormalisedMODE:
                and #$07                     ; Isolate the mode in lowe 3 bits 	; DADA= 29 07       ).
.if !(version==100 && subVersion==7) 		 ; Jamsoft Mode 7 allows modes 0-7...
                cmp #$07                     ; Compare with 7 					; DADC= C9 07       I.
                bcc LDAE2                    ; If mode is greater than or equal to 7 then 	; DADE= 90 02       ..
                lda #$06                     ; Set mode in A to 6 				; DAE0= A9 06       ).
.endif
LDAE2:
                tax                          ; Move mode to X 					; DAE2= AA          *
                asl a                        ; Multiply by 2 					; DAE3= 0A          .
                asl a                        ; Multiply by 4 					; DAE4= 0A          .
                asl a                        ; Multiply by 8 					; DAE5= 0A          .
                rts                          ; Done 							; DAE6= 60          `

;-------------------------------------------------------------------------

; IRQ Handler
; ===========
irqEntryPoint:
                sta $FC                      ; Save A in IRQ store
                pla                          ; Get flags from stack
                pha
                and #$10                     ; If BRK jump to BRK handler
                bne LDB06
                jmp (vectorIRQ1V)                  ; Pass on to vectorIRQ1V

; OSRDRM - read byte from sideways ROM
; ------------------------------------
LDAF2:
                ldx $F4                      ; Save current ROM in X
                sty $F4                      ; Select ROM Y
                jsr prepareForROMPaging                    ; Electron paging mechanism
                sty intClearAndPagingRegister                    ; Page in ROM Y
                ldy #$00                     ; Get byte pointed to by &F6/7
                lda ($F6),y
LDB00:
                pha                          ; Page ROM X back in
                jsr selectROMX
                pla
LDB05:
                rts

; BRK handler
; -----------
LDB06:
                txa                          ; Save X
                pha
                tsx                          ; Get stacked address of BRK
                lda $0103,x
                cld                          ; Ensure operating in binary
                sec                          ; Subtract 1 from address so that
                sbc #$01
                sta $FD
                lda $0104,x                  ; FAULT at &FD/E points to error block
                sbc #$00
                sta $FE
                stx $F0                      ; &F0=stack pointer when BRK occured
                ldx #$06                     ; Issue service call 6 - BRK occured
                jsr osbyte8F
                lda $F4                      ; Save ROM that was paged in at BRK
                sta $024A
                ldx $028C                    ; Get current language ROM and page it in
                jsr LDB00
                pla                          ; Restore X and A, enable IRQs
                tax
                lda $FC
                cli
                jmp (vectorBRKV)                  ; Pass on to vectorBRKV error handler

LDB33:
                ldy #$00                     ; DB33= A0 00        .
                jsr LDC3C                    ; DB35= 20 3C DC     <\
                lda $0267                    ; DB38= AD 67 02    -g.
                ror a                        ; DB3B= 6A          j
LDB3C:
                bcs LDB3C                    ; DB3C= B0 FE       0~
                jsr OSNEWL                   ; DB3E= 20 E7 FF     g.
                jsr OSNEWL                   ; DB41= 20 E7 FF     g.
                jmp LDA83                    ; DB44= 4C 83 DA    L.Z

irq1EntryPoint:
                cld
                lda $FC                      ; restore original A
                pha                          ; save original A
                txa
                pha                          ; save original X
                tya
                pha                          ; save original Y
                lda #>LDB82-1
                pha                          ; save return thunk MSB
                lda #<LDB82-1
                pha                          ; save return thunk LSB
                ldy intStatusAndControlRegister                    ; Y=ULA IRQ flags
                tya                          ; A=ULA IRQ flags
                lsr a                        ; C set if any ULA IRQ
                bcc LDB6F                    ; taken if no ULA IRQ
                tya                          ; A=ULA IRQ flags Form
; Form effective IRQ flags: mask off uninteresting IRQs (as set by
; OSBYTE 203), and mask off bit 0.
                and ulaInterruptMask                    ; mask off uninteresting IRQs
                and #%11111110               ; ignore bit 0
                tax                          ; X=effective IRQ flags
; This bit appears to be irrelevant. See https://www.stardot.org.uk/forums/viewtopic.php?p=471253#p471253
                and #$0C
                bit $25
                txa                          ; A=effective IRQ flags
                and #%01110000               ; isolate tone+tx+rx
                beq handleRTCOrDisplayEndIRQ ; taken if rtc/display end
                jmp LF4DF                    ; handle tone/tx/rq

LDB6F:
                ldx #$05                     ; Issue service call 5 - IRQ occured
                jsr osbyte8F
                beq LDB05                    ; If claimed, exit
                pla                          ; Drop caller address
                pla
                pla                          ; Restore Y and X
                tay
                pla
                tax
                pla                          ; Restore A and A store
                sta $FC
                jmp (vectorIRQ2V)                  ; Pass on to vectorIRQ2V

LDB82:
                pla                          ; Restore Y and X
                tay
                pla
                tax
                pla                          ; Restore A and IRQ store
                sta $FC
LDB89:
                lda $FC                      ; Restore A from IRQ store
                rti                          ; Return from IRQ

;-------------------------------------------------------------------------
;
; Entry: X=original effective IRQ flags

handleRTCOrDisplayEndIRQ:
                txa                          ; A=effective IRQ flags
                ldy #$20                     ; Y=clear RTC IRQ value
                and #$08                     ; isolate RTC bit
                bne LDBC5                    ; taken if RTC IRQ
                txa                          ; A=effective IRQ flags
                and #$04                     ; isolate Display End bit
                beq LDB6F                    ; taken if not display end IRQ
; handle display end IRQ
                jsr LC98E
                lda $0251
                beq LDBBB
                dec $0251
                bne LDBBB
                ldx $0252
                lda $0248
                beq LDBB0
                ldx $0253
LDBB0:
                eor #$07
                sta $0248
                stx $0251
                jsr LC8A3
LDBBB:
                ldy #$04
                jsr LE202
                dec $0240
                ldy #$10                     ; Y=clear Display End IRQ value
LDBC5:
                sty intClearAndPagingRegister
                lda $0283
                tax
                eor #$0F
                pha
                tay
                sec
LDBD1:
                lda $0290,x
                adc #$00
                sta $0290,y
                dex
                beq LDBDF
                dey
                bne LDBD1
LDBDF:
                pla
                sta $0283
                ldx #$05
LDBE5:
                inc $029A,x
                bne LDBF2
                dex
                bne LDBE5
                ldy #$05
                jsr LE202
LDBF2:
                lda $02B0
                bne LDBFF
                lda $02B1
                beq LDC02
                dec $02B1
LDBFF:
                dec $02B0
LDC02:
                bit $0278
                bpl LDC12
                inc $0278
                cli
                jsr LE893
                sei
                dec $0278
LDC12:
                lda $0242
                beq LDC22
                lda $EC
                ora $ED
                clc
                beq LDC1F
                sec
LDC1F:
                jsr LEC49
LDC22:
                ldy $0249
                beq LDC2C
                ldx #$15
                jsr osbyte8F
LDC2C:
                bit $02C6
                bmi LDC45
                jmp LDEF9

LDC34:
                lda #$C3                     ; DC34= A9 C3       )C
LDC36:
                sta $FE                      ; DC36= 85 FE       .~
                lda #$00                     ; DC38= A9 00       ).
                sta $FD                      ; DC3A= 85 FD       .}
LDC3C:
                iny                          ; DC3C= C8          H
.if version==300
                jsr LE765_300
.else
                lda ($FD),y                  ; DC3D= B1 FD       1}
.endif
                jsr OSASCI                   ; DC3F= 20 E3 FF     c.
                tax                          ; DC42= AA          *
                bne LDC3C                    ; DC43= D0 F7       Pw
LDC45:
                rts                          ; DC45= 60          `

LDC46:
                stx $02B0                    ; DC46= 8E B0 02    .0.
                sty $02B1                    ; DC49= 8C B1 02    .1.
                lda #$FF                     ; DC4C= A9 FF       ).
                bne LDC52                    ; DC4E= D0 02       P.
LDC50:
                lda #$00                     ; DC50= A9 00       ).
LDC52:
                sta $E6                      ; DC52= 85 E6       .f
                txa                          ; DC54= 8A          .
                pha                          ; DC55= 48          H
                tya                          ; DC56= 98          .
                pha                          ; DC57= 48          H
                ldy $0256                    ; DC58= AC 56 02    ,V.
                beq LDC71                    ; DC5B= F0 14       p.
                sec                          ; DC5D= 38          8
                ror $EB                      ; DC5E= 66 EB       fk
                jsr OSBGET                   ; DC60= 20 D7 FF     W.
                php                          ; DC63= 08          .
                lsr $EB                      ; DC64= 46 EB       Fk
                plp                          ; DC66= 28          (
                bcc LDC8E                    ; DC67= 90 25       .%
                lda #$00                     ; DC69= A9 00       ).
                sta $0256                    ; DC6B= 8D 56 02    .V.
                jsr OSFIND                   ; DC6E= 20 CE FF     N.
LDC71:
                bit $FF                      ; DC71= 24 FF       $.
                bmi LDC8B                    ; DC73= 30 16       0.
                ldx $0241                    ; DC75= AE 41 02    .A.
                jsr LE32E                    ; DC78= 20 2E E3     .c
                bcc LDC8E                    ; DC7B= 90 11       ..
                bit $E6                      ; DC7D= 24 E6       $f
                bvc LDC71                    ; DC7F= 50 F0       Pp
                lda $02B0                    ; DC81= AD B0 02    -0.
                ora $02B1                    ; DC84= 0D B1 02    .1.
                bne LDC71                    ; DC87= D0 E8       Ph
                bcs LDC90                    ; DC89= B0 05       0.
LDC8B:
                sec                          ; DC8B= 38          8
                lda #$1B                     ; DC8C= A9 1B       ).
LDC8E:
                sta $E6                      ; DC8E= 85 E6       .f
LDC90:
                pla                          ; DC90= 68          h
                tay                          ; DC91= A8          (
                pla                          ; DC92= 68          h
                tax                          ; DC93= AA          *
                lda $E6                      ; DC94= A5 E6       %f
                rts                          ; DC96= 60          `

LDC97:
                .text ")C("                  ; Copyright match string
                .byte 0 ;

LDC9B:
                .text "."                    ;
                .beword callFSCV
                .byte $05
                .text "FX"                   ; XY=>parameters
                .beword LE0B0
                .byte $FF
                .text "BASIC"                ;
                .beword LDDA1
                .byte $00
                .text "CAT"                  ; XY=>parameters, FSC &05
                .beword callFSCV
                .byte fscStarCAT
                .text "CODE"                 ; X,Y=parameters, OSBYTE &88
                .beword LE0B6
                .byte $88
                .text "EXEC"                 ;
                .beword LF5EA
                .byte $00
                .text "HELP"                 ; XY=>parameters
                .beword LEED5
                .byte $FF
                .text "KEY"                  ; XY=>parameters
                .beword LE095
                .byte $FF
                .text "LOAD"                 ;
                .beword LDFAA
                .byte $00
                .text "LINE"                 ;
                .beword callUSERV
                .byte $01
                .text "MOTOR"                ; X,Y=parameters, OSBYTE &89
                .beword LE0B6
                .byte $89
                .text "OPT"                  ; X,Y=parameters, OSBYTE &8B
                .beword LE0B6
                .byte $8B
                .text "RUN"                  ; XY=>parameters, FSC &04
                .beword callFSCV
                .byte fscStarRUN
                .text "ROM"                  ; X,Y=parameters, OSBYTE &8D
                .beword LE0B6
                .byte $8D
                .text "SAVE"                 ;
                .beword LDFAC
                .byte $00
                .text "SPOOL"                ;
                .beword LDFEF
                .byte $00
                .text "TAPE"                 ; X,Y=parameters, OSBYTE &8C
                .beword LE0B6
                .byte $8C
                .text "TV"                   ; X,Y=parameters, OSBYTE &90
                .beword LE0B6
                .byte $90
                .text ""                     ; FSC &03
                .beword callFSCV
                .byte fscUnknownCommand
                .byte $00

.if version==100
                .include "oscli.s65"
.endif
                
LDDD7:
                jsr skipSpacesAndCheckForCRInStringInput                    ; DDD7= 20 C3 DD     C]
                jsr readDigitFromString                    ; DDDA= 20 06 DE     .^
.if version==300
                bcc LDD28_300
.else
                bcc LDE16                    ; DDEA= B0 2A       0*
.endif
LDDDF:
                sta $E6                      ; DDDF= 85 E6       .f
                jsr readNextDigitFromString                    ; DDE1= 20 05 DE     .^
                bcc LDDFF                    ; DDE4= 90 19       ..
                tax                          ; DDE6= AA          *
                lda $E6                      ; DDE7= A5 E6       %f
                asl a                        ; DDE9= 0A          .
.if version==300
                bcs LDD28_300
.else
                bcs LDE16                    ; DDEA= B0 2A       0*
.endif
                asl a                        ; DDEC= 0A          .
.if version==300
                bcs LDD28_300
.else
                bcs LDE16                    ; DDEA= B0 2A       0*
.endif
                adc $E6                      ; DDEF= 65 E6       ef
.if version==300
                bcs LDD28_300
.else
                bcs LDE16                    ; DDEA= B0 2A       0*
.endif
                asl a                        ; DDF3= 0A          .
.if version==300
                bcs LDD28_300
.else
                bcs LDE16                    ; DDEA= B0 2A       0*
.endif
                sta $E6                      ; DDF6= 85 E6       .f
                txa                          ; DDF8= 8A          .
                adc $E6                      ; DDF9= 65 E6       ef
.if version==100
                bcs LDE16                    ; DDEA= B0 2A       0*
.endif
                bcc LDDDF                    ; DDFD= 90 E0       .`
.if version==300
LDD28_300:
                clc
                rts
.endif
LDDFF:
                ldx $E6                      ; DDFF= A6 E6       &f
                cmp #$0D                     ; DE01= C9 0D       I.
                sec                          ; DE03= 38          8
                rts                          ; DE04= 60          `


.if version==100
                .include "readDigitFromString.s65"
                .include "LDE13.s65"
                .include "readHexDigitFromString.s65"
.endif

LDE2D:
                pha                          ; DE2D= 48          H
                txa                          ; DE2E= 8A          .
                pha                          ; DE2F= 48          H
                tya                          ; DE30= 98          .
                pha                          ; DE31= 48          H
                tsx                          ; DE32= BA          :
                lda $0103,x                  ; DE33= BD 03 01    =..
                pha                          ; DE36= 48          H
                bit $0260                    ; DE37= 2C 60 02    ,`.
                bpl LDE44                    ; DE3A= 10 08       ..
                tay                          ; DE3C= A8          (
                lda #$04                     ; DE3D= A9 04       ).
                jsr callNETV                    ; DE3F= 20 95 E3     .c
                bcs LDE9D                    ; DE42= B0 59       0Y
LDE44:
                clc                          ; DE44= 18          .
                lda #$02                     ; DE45= A9 02       ).
                bit $027C                    ; DE47= 2C 7C 02    ,|.
                bne LDE51                    ; DE4A= D0 05       P.
                pla                          ; DE4C= 68          h
                pha                          ; DE4D= 48          H
                jsr LD6D8                    ; DE4E= 20 D8 D6     XV
LDE51:
                lda #$08                     ; DE51= A9 08       ).
                bit $027C                    ; DE53= 2C 7C 02    ,|.
                bne LDE5A                    ; DE56= D0 02       P.
                bcc LDE5F                    ; DE58= 90 05       ..
LDE5A:
                pla                          ; DE5A= 68          h
                pha                          ; DE5B= 48          H
                jsr LDEA4                    ; DE5C= 20 A4 DE     $^
LDE5F:
                lda $027C                    ; DE5F= AD 7C 02    -|.
                ror a                        ; DE62= 6A          j
                bcc LDE87                    ; DE63= 90 22       ."
                ldy $EA                      ; DE65= A4 EA       $j
                dey                          ; DE67= 88          .
                bpl LDE87                    ; DE68= 10 1D       ..
                pla                          ; DE6A= 68          h
                pha                          ; DE6B= 48          H
                php                          ; DE6C= 08          .
                sei                          ; DE6D= 78          x
                bit $024F                    ; DE6E= 2C 4F 02    ,O.
                php                          ; DE71= 08          .
                ldx #$02                     ; DE72= A2 02       ".
                jsr LDF68                    ; DE74= 20 68 DF     h_
                plp                          ; DE77= 28          (
                bpl LDE86                    ; DE78= 10 0C       ..
                ldx #$13                     ; DE7A= A2 13       ".
                jsr osbyte8F                    ; DE7C= 20 A8 F0     (p
                beq LDE86                    ; DE7F= F0 05       p.
                ldx #$02                     ; DE81= A2 02       ".
                jsr LDF09                    ; DE83= 20 09 DF     ._
LDE86:
                plp                          ; DE86= 28          (
LDE87:
                lda #$10                     ; DE87= A9 10       ).
                bit $027C                    ; DE89= 2C 7C 02    ,|.
                bne LDE9D                    ; DE8C= D0 0F       P.
                ldy $0257                    ; DE8E= AC 57 02    ,W.
