; Negative INKEY translation table overlaps following, giving results for -123 to -126
; ------------------------------------------------------------------------------------
; Mixed keys translation table
;
LEEBA:
                .text "]" ; ] \ 7A -123 -> &1D U
                .text "~" ; ~ \ 7B -124 -> &3E selects H to RETURN
                .byte $5c ; \ \ 7C -125 -> &1C 7
                .text "}" ; } \ 7D -126 -> &3D selects Y to COPY
                .text "{" ; { \ 7E -127 -> &3B SHIFT

