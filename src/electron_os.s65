LEFFC:
                cmp #$60                     ; EFFC= C9 60       I`
                bne LF002                    ; EFFE= D0 02       P.
                lda #$5F                     ; F000= A9 5F       )_
LF002:
                cmp #$40                     ; F002= C9 40       I@
                bcc LF008                    ; F004= 90 02       ..
                and #$1F                     ; F006= 29 1F       ).
LF008:
                rts                          ; F008= 60          `

LF009:
                .text "/!BOOT"               ; Command string for ROMFS boot
                .byte 13

