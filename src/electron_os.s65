                sta $034C                    ; CA8E= 8D 4C 03    .L.
                lda vduBytesPerCharacter                    ; CA91= AD 4F 03    -O.
                lsr a                        ; CA94= 4A          J
                beq LCAA0                    ; CA95= F0 09       p.
LCA97:
                asl $034C                    ; CA97= 0E 4C 03    .L.
                rol vduTextWindowWidthInBytesHigh                    ; CA9A= 2E 4D 03    .M.
                lsr a                        ; CA9D= 4A          J
                bcc LCA97                    ; CA9E= 90 F7       .w
LCAA0:
                rts                          ; CAA0= 60          `

