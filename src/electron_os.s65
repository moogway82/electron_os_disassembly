LE3B1:
                .word osbyte00 ;OSBYTE 0 (&00) Display MOS version [MasRef D.2-18]
                .word osbyte01 ; OSBYTE 1 (&01) Write user flag [MasRef D.2-18]
                .word osbyte02 ; &02 - Specify input stream [MasRef D.2-18]
                .word osbyte03 ; &03 - Specify output stream [MasRef D.2-19]                 
                .word osbyte04 ; &04 - Enable/disable cursor editing [MasRef D.2-19]         
                .word osbyte05 ; &05 - Write printer driver type [MasRef D.2-20]             
                .word osbyte06 ; &06 - Write printer ignore character [MasRef D.2-21]        
                .word osbyteUnused ; &07 - Write RS423 receive rate [MasRef D.2-21]              
                .word osbyteUnused ; &08 - Write RS423 transmit rate [MasRef D.2-22]             
                .word osbyte09 ; &09 - Write duration of first colour [MasRef D.2-22]        
                .word osbyte0A ; &0A - Write duration of second colour [MasRef D.2-22]      
                .word osbyte0B ; &0B - Write keyboard auto-repeat delay [MasRef D.2-22]     
                .word osbyte0C ; &0C - Write keyboard auto-repeat rate [MasRef D.2-23]      
                .word osbyte0D ; &0D - Disable event [MasRef D.2-23]                        
                .word osbyte0E ; &0E - Enable event [MasRef D.2-24]                         
                .word osbyte0F ; &0F - Flush buffer [MasRef D.2-24]                         
                .word osbyteUnused ; &10 - Write number of ADC channels [MasRef D.2-25]         
                .word osbyteUnused ; &11 - Write next ADC channel to be sampled [MasRef D.2-25] 
                .word osbyte12 ; &12 - Reset soft keys [MasRef D.2-26]                      
                .word osbyte13 ; &13 - Wait for vertical sync [MasRef D.2-26]               
                .word osbyte14 ; &14 - Restore default font definitions [MasRef D.2-26]     
                .word osbyte15 ; &15 - Flush selected buffer [MasRef D.2-27]                
                .word osbyte16 ; &16 - Increment ROM polling semaphore
                .word osbyte17 ; &17 - Decrement ROM polling semaphore
                .word osbyteUnused ; &18 - Select external sound system
                .word osbyte73 ; &73 - Reset palette
                .word osbyte74 ; &74 - Reset sound system
                .word osbyte75 ; &75 - Read VDU status byte
                .word osbyte76 ; &76 - Reflect keyboard status in keyboard [MasRef D.2-33]
                .word osbyte77 ; &77 - Close all *SPOOL/*SPOOLON or [MasRef D.2-33]
                .word osbyte78 ; &78 - Write keys pressed
                .word osbyte79 ; &79 - Keyboard scan [MasRef D.2-35]
                .word osbyte7A ; &7A - Keyboard scan from &10
                .word osbyte7B ; &7B - Printer going idle
                .word osbyte7C ; &7C - Set Escape state
                .word osbyte7D ; &7D - Clear Escape state
                .word osbyte7E ; &7E - Acknowledge Escape state
                .word osbyte7F ; &7F - Read EOF
                .word osbyte80 ; &80 - ADVAL
                .word osbyte81 ; &81 - INKEY
                .word osbyte82 ; &82 - Read memory high word
                .word osbyte83 ; &83 - Read bottom of user memory
                .word osbyte84 ; &84 - Read top of user memory
                .word osbyte85 ; &85 - Read top of user memory for specified MODE
                .word osbyte86 ; &86 - Read text cursor position [MasRef D.2-41]              
                .word osbyte87 ; &87 - Read screen mode and character at [MasRef D.2-42]      
                .word osbyte88 ; &88 - Execute user code [MasRef D.2-42]                      
                .word osbyte89 ; &89 - Switch cassette motor relay [MasRef D.2-42]            
                .word osbyte8A ; &8A - Insert character code into buffer [MasRef D.2-43]      
                .word osbyte8B ; &8B - Write Filing System options [MasRef D.2-43]            
                .word osbyte8C8D ; &8C - Select Cassette Filing System [MasRef D.2-43]          
                .word osbyte8C8D ; &8D - Select ROM Filing System [MasRef D.2-43]               
                .word osbyte8E ; &8E - Enter language ROM [MasRef D.2-44]                     
                .word osbyte8F ; &8F - Issue paged ROM service request [MasRef D.2-44]        
                .word osbyte90 ; &90 - Set vertical screen shift and interlace [MasRef D.2-44]
                .word osbyte91 ; &91 - Get character from buffer [MasRef D.2-45]                
                .word osbyte92 ; &92 - Read from FRED (&FC00 – &FCFF) [MasRef D.2-45]           
                .word osbyte93 ; &93 - Write to FRED (&FC00 – &FCFF) [MasRef D.2-45]            
                .word osbyte94 ; &94 - Read from JIM (&FD00 – &FDFF) [MasRef D.2-45]            
                .word osbyte95 ; &95 - Write to JIM (&FD00 – &FDFF) [MasRef D.2-45]             
                .word osbyte96 ; &96 - Read from SHEILA (&FE00 – &FEFF) [MasRef D.2-45]         
