; OSBYTE &81 - INKEY
; ==================
osbyte81:
                tya                          ; E4D0= 98          .
                bmi LE4DE                    ; E4D1= 30 0B       0.
                cli                          ; E4D3= 58          X
                jsr LDC46                    ; E4D4= 20 46 DC     F\
                bcs LE4DC                    ; E4D7= B0 03       0.
                tax                          ; E4D9= AA          *
